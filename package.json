{
  "name": "scutiva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:vendor": "mkdir -p ./static/vendor/js && cp ./node_modules/htmx.org/dist/htmx.min.js ./static/vendor/js/htmx.min.js && cp ./node_modules/alpinejs/dist/cdn.min.js ./static/vendor/js/alpine.min.js",
    "build:css": "tailwindcss -i ./static_src/tailwind.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./static_src/tailwind.css -o ./static/css/app.css --watch",
    "build": "npm run build:vendor && npm run build:css"
  },
  "devDependencies": {
    "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.4",
    "tailwindcss": "^3.4.17"
  }
}